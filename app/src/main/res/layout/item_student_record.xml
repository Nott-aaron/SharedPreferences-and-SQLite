<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_display_box"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <!-- Student ID Badge -->
    <TextView
        android:id="@+id/tvItemId"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_header_badge"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp" />

    <!-- Name and USN -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemUsn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USN: 1BM21CS001"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Delete Record Button -->
    <ImageButton
        android:id="@+id/btnItemDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_button_danger"
        android:contentDescription="Delete Record"
        android:src="@drawable/ic_delete"
        android:padding="6dp" />

</LinearLayout>
