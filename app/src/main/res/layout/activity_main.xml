<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/charcoal_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_student_card"
                android:contentDescription="Student Data Manager Logo"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- SECTION 1: SHAREDPREFERENCES CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    android:contentDescription="Profile Icon"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_shared_pref"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPrefName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_profile_name"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="textPersonName"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:minHeight="48dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etPrefUsn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_profile_usn"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:drawableStart="@drawable/ic_badge"
                android:drawablePadding="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:minHeight="48dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <android.widget.Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/btn_save"
                    android:textColor="@color/btn_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <android.widget.Button
                    android:id="@+id/btnLoadProfile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/btn_load"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <android.widget.Button
                    android:id="@+id/btnClearProfile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_danger"
                    android:text="@string/btn_clear"
                    android:textColor="@color/delete_text"
                    android:textSize="13sp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Saved Profile Display Box -->
            <TextView
                android:id="@+id/tvProfileDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_display_box"
                android:text="@string/no_profile_loaded"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:padding="12dp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- SECTION 2: SQLITE DATABASE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_database"
                    android:contentDescription="Database Icon"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_sqlite"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDbName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_db_name"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="textPersonName"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:minHeight="48dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etDbUsn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_db_usn"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:drawableStart="@drawable/ic_badge"
                android:drawablePadding="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:minHeight="48dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <android.widget.Button
                    android:id="@+id/btnAddStudent"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/btn_add_student"
                    android:textColor="@color/btn_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <android.widget.Button
                    android:id="@+id/btnViewStudents"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/btn_view_students"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Delete by ID Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etDeleteId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_delete_id"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:minHeight="48dp"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <android.widget.Button
                    android:id="@+id/btnDeleteStudent"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_danger"
                    android:text="@string/btn_delete_student"
                    android:textColor="@color/delete_text"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

            <!-- Container for Dynamic Student List Items -->
            <LinearLayout
                android:id="@+id/llStudentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Fallback Text Display -->
            <TextView
                android:id="@+id/tvDbDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_display_box"
                android:text="@string/no_db_records"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:padding="12dp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
